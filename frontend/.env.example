# SkyPulse Frontend Environment Variables

# Google Maps JavaScript API Key (Maps JavaScript API enabled in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend API URL (override for production Cloudflare Pages -> Oracle Cloud VM)
VITE_API_BASE_URL=

# WebSocket URL (override for production Cloudflare Pages -> Oracle Cloud VM wss://...)
VITE_WS_URL=
