# SkyPulse Backend Environment Configuration Example

# App Settings
APP_NAME=SkyPulse
APP_ENV=development
DEBUG=true
PORT=8000
SECRET_KEY=change-this-in-production-min-32-chars

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skypulse

# Firebase Cloud Storage (Private media archival)
FIREBASE_STORAGE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CREDENTIALS_PATH=

# Object Storage Fallback (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=skypulse-media
MINIO_SECURE=false

# AI / LLM Intelligence Layer (Groq)
AI_PROVIDER=auto
GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=15.0
GROQ_MAX_RETRIES=2

