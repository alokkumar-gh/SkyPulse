# SkyPulse Environment Configuration

# Application
APP_NAME=SkyPulse
APP_ENV=development
DEBUG=true
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","https://skypulse.pages.dev"]
FRONTEND_URL=

# Security & Authentication
SECRET_KEY=skypulse-super-secret-key-change-in-production-min-32-chars
JWT_SECRET=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL with PostGIS & pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=skypulse
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skypulse
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis (Caching & Pub/Sub)
REDIS_URL=redis://localhost:6379/0

# Redpanda / Kafka Event Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDPANDA_MEMORY=1G

# OpenSearch (Full-Text Search & Log Analytics)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# Neo4j (Dynamic Weather Evidence Graph - DWEG)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_HEAP_INITIAL_SIZE=512M
NEO4J_HEAP_MAX_SIZE=512M
NEO4J_PAGECACHE_SIZE=512M

# Firebase Cloud Storage (Private media archival)
FIREBASE_STORAGE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CREDENTIALS_PATH=

# MinIO (S3-compatible Object Storage for Media)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=skypulse-media
MINIO_SECURE=false

# Weather APIs (Optional - system gracefully degrades if not provided)
WEATHERAPI_KEY=
OPENWEATHERMAP_KEY=
IMD_ENABLED=false
IMD_API_BASE_URL=
IMD_API_KEY=
IMD_POLL_INTERVAL_SECONDS=300
DATA_GOV_ENABLED=false
DATA_GOV_API_BASE_URL=https://api.data.gov.in
DATA_GOV_API_KEY=
DATA_GOV_POLL_INTERVAL_SECONDS=600
DATA_GOV_RESOURCES=

# AI / LLM Pipeline Configuration
AI_PROVIDER=auto
GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=15.0
GROQ_MAX_RETRIES=2
LLM_PROVIDER=disabled
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2
CLASSIFICATION_MODEL=facebook/bart-large-mnli

# Real AI/ML Intelligence Layer (Step 5 - ₹0 Oracle Always-Free CPU & Colab)
ML_ENABLED=true
ML_MODEL_DIR=/app/models
WEATHER_CLASSIFIER_MODEL=weather_event_classifier
WEATHER_CLASSIFIER_VERSION=1.0.0
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CREDIBILITY_MODEL=credibility_model
CREDIBILITY_MODEL_VERSION=1.0.0
ANOMALY_MODEL=anomaly_model
ANOMALY_MODEL_VERSION=1.0.0
ML_CLASSIFICATION_THRESHOLD=0.65
ML_CREDIBILITY_THRESHOLD=0.60
ML_DUPLICATE_THRESHOLD=0.82
ML_ANOMALY_THRESHOLD=0.70

# Demo Mode & Simulation Flags
DEMO_MODE=true
SYNTHETIC_STREAM_INTERVAL_SECONDS=10

# Frontend UI Configuration
VITE_API_BASE_URL=
VITE_WS_URL=
VITE_GOOGLE_MAPS_API_KEY=
